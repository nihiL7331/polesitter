---
Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  readability-*,
  cert-*,
  -bugprone-easily-swappable-parameters,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-isolate-declaration,

WarningsAsErrors: '*'

CheckOptions:
  - key:   bugprone-macro-parantheses.Strict
    value: 'true'
